# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (hoisted to root + any nested in workspaces)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js (per-workspace build output)
.next/
out/
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# cloudflare (opennext adapter build output)
.open-next/
.wrangler/
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Single lockfile: package-lock.json. A committed yarn.lock made Vercel install
# with yarn, which bakes in only the lockfile-generating platform for sharp.
yarn.lock
pnpm-lock.yaml
