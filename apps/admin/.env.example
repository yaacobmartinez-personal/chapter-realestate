# Admin CMS — admin.chapterrealestate.ca

# Supabase (auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image storage (Supabase Storage) — uses the Supabase keys above.
# Optional; defaults to "images". The bucket must be public (see packages/db/storage.sql).
SUPABASE_STORAGE_BUCKET=images
