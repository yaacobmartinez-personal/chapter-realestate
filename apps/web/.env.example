# Public site — reads content from Supabase (falls back to bundled JSON if unset).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox — required by the contact page office map (components/contact/MapEmbed).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Google Maps — OPTIONAL. The property-page map works without it, using
# Google's keyless `output=embed` URL (undocumented, no support commitment).
# Set this to switch to the official, supported Maps Embed API instead —
# no code change needed. Enable "Maps Embed API" on the key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Existing integrations (carried over from before the monorepo split).
# EDITOR_PASSWORD=...        # legacy inline editor — superseded by the admin app
